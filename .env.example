# Laisser vide pour le mode local (sans serveur).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Clé publique des notifications (web push), voir README « Notifications ».
VITE_VAPID_PUBLIC_KEY=
# Nom de l'appli installée (sous l'icône du téléphone, écran de démarrage, titre de l'onglet), figé à la construction.
# Laisser vide pour le nom du sport : « Nextar Hand » (handball), « Nextar Volley » (VITE_SPORT=volley) ; 12 caractères
# environ tiennent sous une icône Android. Dans l'interface, le logo reste « Nextar », suivi du sport.
VITE_APP_NAME=
# Sport par défaut de l'installation quand la table hb_config n'a pas de ligne « sport » : handball (vide) ou volley.
# Sert aux constructions et à la démo, et à la version d'essai (VITE_TRIAL=1). La ligne « sport » de hb_config décide sinon.
VITE_SPORT=
